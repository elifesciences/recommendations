{
    "name": "elife/recommendations",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "eLife\\Recommendations\\": "src"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "test\\eLife\\Recommendations\\": "test"
        }
    },
    "require": {
        "elife/api-client": "^1.0",
        "elife/api-problem": "^1.1",
        "elife/api-sdk": "dev-symfony-7",
        "elife/content-negotiator": "dev-symfony-7",
        "elife/logging-sdk": "dev-symfony-7",
        "elife/ping": "dev-symfony-7",
        "guzzlehttp/guzzle": "^6.3",
        "guzzlehttp/promises": "^1.3",
        "psr/log": "^3.0",
        "willdurand/negotiation": "^3.1",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "elife/api": "^2.30",
        "elife/api-validator": "dev-php8.3",
        "justinrainbow/json-schema": "^5.2",
        "nyholm/psr7": "^1.1",
        "phpunit/phpunit": "^12.5.0",
        "squizlabs/php_codesniffer": "^3.5",
        "symfony/browser-kit": "^7.4",
        "symfony/psr-http-message-bridge": "7.4.*"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
